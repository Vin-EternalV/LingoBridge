PORT=5000
MONGODB_URI=mongodb://localhost:27017/lingobridge
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE=7d
GEMINI_API_KEY=your_gemini_api_key_here
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-3.6-flash
# For OpenAI instead, use AI_PROVIDER=openai, AI_API_KEY, and AI_MODEL.
# Comma-separated browser origins. Leave unset in development to allow Expo's development origin.
CORS_ORIGINS=http://localhost:8081
# On Render Free, use an email API because outbound SMTP ports are blocked.
# Create a Resend API key and verify a sender domain, then set these in Render.
# RESEND_API_KEY=re_xxxxxxxxx
# RESEND_FROM=LingoBridge <verify@your-verified-domain.com>
