PORT=5000
FRONTEND_URL=http://localhost:8081
MONGODB_URI=mongodb://localhost:27017/lingobridge
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE=7d
GEMINI_API_KEY=your_gemini_api_key_here
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-3.6-flash
# For OpenAI instead, use AI_PROVIDER=openai, AI_API_KEY, and AI_MODEL.
# Comma-separated browser origins. Leave unset in development to allow Expo's development origin.
CORS_ORIGINS=http://localhost:8081
# On Render Free, use an email API because outbound SMTP ports are blocked.
# Create a Brevo API key and verify a sender address in Brevo, then set these in Render.
# BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxx
# BREVO_FROM_EMAIL=your-verified-sender@example.com
# BREVO_FROM_NAME=LingoBridge
